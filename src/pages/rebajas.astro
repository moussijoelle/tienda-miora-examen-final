---
import Tienda from '../layouts/Tienda.astro'
import { getProductosEnRebaja, type Producto } from '../lib/productos'

const lista: Producto[] = await getProductosEnRebaja()
const rebajas = lista.map((p) => {
  const precio = Number(p.precio)
  const descuento = Number(p.descuento)
  const precioFinal = Number((precio * (1 - descuento / 100)).toFixed(2))
  return { ...p, precio, descuento, precioFinal }
})
---

<Tienda titulo="Rebajas — Miora">
  <section class="mx-auto max-w-6xl px-8 py-10">
    <h1 class="text-3xl font-light">Rebajas</h1>
    <p class="mt-2 text-sm text-neutral-500">Vestidos con descuento</p>
    <p class="mt-1 text-sm text-neutral-400">{rebajas.length} prendas</p>

    <ul class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
      {rebajas.map((p) => (
        <li>
          <a href={`/producto/${p.pk_producto}`} class="block">
            <div class="aspect-3/4 overflow-hidden bg-neutral-100">
              {p.url_imagen && (
                <img
                  src={p.url_imagen}
                  alt={p.nombre_producto}
                  class="h-full w-full object-cover object-top"
                />
              )}
            </div>
            <h2 class="mt-3 text-sm font-medium">{p.nombre_producto}</h2>
            <p class="mt-1 text-xs text-neutral-400">-{p.descuento}%</p>
            <p class="mt-1 text-sm">
              <span class="text-neutral-400 line-through">
                {p.precio.toFixed(2).replace('.', ',')} €
              </span>
              <span class="ml-2 text-red-600">{p.precioFinal.toFixed(2).replace('.', ',')} €</span>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Tienda>
