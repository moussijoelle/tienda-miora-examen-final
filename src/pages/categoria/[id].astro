---
import Tienda from '../../layouts/Tienda.astro'
import { getCategoriaByPk, type Categoria } from '../../lib/categorias'
import { getProductosByCategoria, type Producto } from '../../lib/productos'

const pk = Astro.params.id ?? ''
const categoria: Categoria | null = await getCategoriaByPk(pk)

if (!categoria) {
  return Astro.redirect('/')
}

const lista: Producto[] = await getProductosByCategoria(categoria.pk_categoria)
const productos = lista.map((p) => {
  const precio = Number(p.precio)
  const descuento = Number(p.descuento)
  const precioFinal =
    descuento > 0
      ? Number((precio * (1 - descuento / 100)).toFixed(2))
      : precio
  return { ...p, precio, descuento, precioFinal }
})
---

<Tienda titulo={`${categoria.nom_categoria} — Miora`}>
  <section class="mx-auto max-w-6xl px-8 py-10">
    <h1 class="text-3xl font-light">{categoria.nom_categoria}</h1>
    <p class="mt-2 text-sm text-neutral-500">{categoria.descripcion_categoria}</p>
    <p class="mt-1 text-sm text-neutral-400">{productos.length} prendas</p>

    <ul class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
      {productos.map((p) => (
        <li>
          <a href={`/producto/${p.pk_producto}`} class="block">
            <figure class="aspect-3/4 overflow-hidden bg-neutral-100">
              {p.url_imagen && (
                <img
                  src={p.url_imagen}
                  alt={p.nombre_producto}
                  class="h-full w-full object-cover object-top"
                />
              )}
            </figure>
            <h2 class="mt-3 text-sm font-medium">{p.nombre_producto}</h2>
            {p.descuento > 0 ? (
              <>
                <p class="mt-1 text-xs text-neutral-400">-{p.descuento}%</p>
                <p class="mt-1 text-sm">
                  <span class="text-neutral-400 line-through">
                    {p.precio.toFixed(2).replace('.', ',')} €
                  </span>
                  <span class="ml-2 text-red-600">
                    {p.precioFinal.toFixed(2).replace('.', ',')} €
                  </span>
                </p>
              </>
            ) : (
              <p class="mt-1 text-sm">{p.precio.toFixed(2).replace('.', ',')} €</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Tienda>
