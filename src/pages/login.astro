                  Crear cuenta
                </a>
                <p class="mt-1 text-xs text-neutral-400">Primera vez</p>
              </div>
            </div>

            <div
              id="registro"
              class="scroll-mt-8 border-t border-neutral-200 bg-neutral-50 px-8 py-10 sm:px-10 md:border-l md:border-t-0"
            >
              <h2 class="text-lg font-light text-miora">Registro</h2>
              <p class="mt-1 text-sm text-neutral-500">
                Crea tu cuenta de cliente
              </p>

              <form id="form-registro" class="mt-6 space-y-3 text-left">
                <p
                  id="error-registro"
                  class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
                  role="alert"
                ></p>
                <p
                  id="ok-registro"
                  class="hidden rounded border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800"
                  role="status"
                ></p>
                <div>
                  <label for="nombre" class="block text-sm text-neutral-600">Nombre</label>
                  <input
                    id="nombre"
                    name="nombre"
                    type="text"
                    required
                    autocomplete="given-name"
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="apellido1" class="block text-sm text-neutral-600">Apellido</label>
                  <input
                    id="apellido1"
                    name="apellido1"
                    type="text"
                    required
                    autocomplete="family-name"
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm text-neutral-600">Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="telefono" class="block text-sm text-neutral-600">Teléfono</label>
