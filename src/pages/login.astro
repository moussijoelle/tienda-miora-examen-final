---
import Tienda from '../layouts/Tienda.astro'
import { supabase } from '../lib/supabase'

function rutaSegura(ruta: string | null) {
  if (!ruta || !ruta.startsWith('/') || ruta.startsWith('//')) {
    return null
  }
  return ruta
}

const nextParam = rutaSegura(Astro.url.searchParams.get('next'))
const quierePagar = Astro.url.searchParams.get('pagar') === '1'
const destinoTrasLogin =
  nextParam && quierePagar
    ? `${nextParam}${nextParam.includes('?') ? '&' : '?'}pagar=1`
    : nextParam

const accessToken = Astro.cookies.get('sb-access-token')
const refreshToken = Astro.cookies.get('sb-refresh-token')
let user = null
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  })

  if (data.user) {
    user = data.user
  }
  console.log('ID del usuario activo en servidor:', user?.id)
}

if (user && destinoTrasLogin) {
  return Astro.redirect(destinoTrasLogin)
}
---

<Tienda titulo="Iniciar sesión — Miora">
  <section class="flex min-h-[70vh] items-center justify-center px-4 py-12">
    <div
      class="relative w-full max-w-3xl border border-neutral-300 bg-white shadow-sm"
      role="dialog"
      aria-labelledby="titulo-login"
    >
      <a
        href="/"
        class="absolute right-3 top-3 z-10 flex h-8 w-8 items-center justify-center text-xl leading-none text-neutral-700 hover:bg-neutral-100"
        aria-label="Cerrar"
      >
        ×
      </a>

      {
        user ? (
          <div class="px-8 py-12 text-center sm:px-12">
            <h1 id="titulo-login" class="text-2xl font-light text-miora">
              Bienvenida
            </h1>
            <p class="mt-6 text-sm text-neutral-700">
              Sesión iniciada con: <strong>{user.email}</strong>
            </p>
            <p class="mt-2 text-sm text-neutral-600">
              Tu ID de Supabase es: <code class="text-xs">{user.id}</code>
            </p>
            <form action="/api/auth/signout" method="POST" class="mt-8">
              <button
                type="submit"
                class="bg-neutral-800 px-8 py-3 text-sm text-white hover:bg-neutral-700"
              >
                Cerrar Sesión
              </button>
            </form>
          </div>
        ) : (
          <div class="grid md:grid-cols-2">
            <div class="flex flex-col px-8 py-10 sm:px-10">
              <p class="text-center text-xs tracking-wide text-neutral-400">Google</p>
              <h1 id="titulo-login" class="mt-4 text-center text-2xl font-light text-miora">
                Iniciar sesión
              </h1>
              <p class="mt-2 text-center text-sm text-neutral-500">
                Utiliza tu cuenta de Google
              </p>

              <button
                type="button"
                id="login-btn"
                class="mt-10 flex w-full items-center justify-center gap-3 border border-neutral-300 px-4 py-3 text-sm hover:bg-neutral-50"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
                Iniciar Sesión con Google
              </button>

              <div class="mt-auto pt-10">
                <a
                  href="/login?panel=registro"
                  class="text-sm text-miora underline underline-offset-4 hover:opacity-70"
                >
                  Crear cuenta
                </a>
                <p class="mt-1 text-xs text-neutral-400">Primera vez</p>
              </div>
            </div>

            <div
              id="registro"
              class="scroll-mt-8 border-t border-neutral-200 bg-neutral-50 px-8 py-10 sm:px-10 md:border-l md:border-t-0"
            >
              <h2 class="text-lg font-light text-miora">Registro</h2>
              <p class="mt-1 text-sm text-neutral-500">
                Formulario con los datos del nuevo cliente
              </p>

              <form id="form-registro" class="mt-6 space-y-4 text-left">
                <div>
                  <label for="nombre" class="block text-sm text-neutral-600">Nombre</label>
                  <input
                    id="nombre"
                    name="nombre"
                    type="text"
                    required
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm text-neutral-600">Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="password" class="block text-sm text-neutral-600">Contraseña</label>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <button
                  type="submit"
                  class="mt-2 w-full bg-neutral-800 px-8 py-3 text-sm text-white hover:bg-neutral-700"
                >
                  Crear cuenta
                </button>
              </form>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Tienda>

<script>
  import { supabase } from '../lib/supabase'

  function guardarCookiesSesion(accessToken: string, refreshToken: string) {
    const maxAge = 60 * 60 * 24 * 7
    document.cookie = `sb-access-token=${accessToken}; path=/; max-age=${maxAge}; SameSite=Lax`
    document.cookie = `sb-refresh-token=${refreshToken}; path=/; max-age=${maxAge}; SameSite=Lax`
  }

  function destinoGuardado() {
    const params = new URLSearchParams(window.location.search)
    const next = params.get('next')
    const pagar = params.get('pagar') === '1'
    if (next && next.startsWith('/') && !next.startsWith('//')) {
      return pagar ? `${next}${next.includes('?') ? '&' : '?'}pagar=1` : next
    }
    const guardado = sessionStorage.getItem('miora-post-login')
    if (guardado && guardado.startsWith('/') && !guardado.startsWith('//')) {
      return guardado
    }
    return '/'
  }

  const loginBtn = document.getElementById('login-btn')
  loginBtn?.addEventListener('click', async () => {
    const destino = destinoGuardado()
    if (destino !== '/') {
      sessionStorage.setItem('miora-post-login', destino)
    }
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login`,
      },
    })
  })

  // Guía: al volver de Google a /login?code=... canjear y guardar cookies
  const codigoAuth = new URLSearchParams(window.location.search).get('code')
  if (codigoAuth) {
    const { data, error } = await supabase.auth.exchangeCodeForSession(codigoAuth)
    if (!error && data.session) {
      guardarCookiesSesion(data.session.access_token, data.session.refresh_token)
      const destino = destinoGuardado()
      sessionStorage.removeItem('miora-post-login')
      window.location.replace(destino)
    }
  }

  supabase.auth.onAuthStateChange(async (event, session) => {
    if (session) {
      guardarCookiesSesion(session.access_token, session.refresh_token)
    } else if (event === 'SIGNED_OUT') {
      document.cookie = 'sb-access-token=; path=/; max-age=0'
      document.cookie = 'sb-refresh-token=; path=/; max-age=0'
    }
  })

  async function checkUser() {
    const {
      data: { user },
    } = await supabase.auth.getUser()
    if (user) {
      console.log('ID del usuario activo en cliente:', user.id)
    }
  }
  checkUser()

  function alEnviarRegistro(evento: Event) {
    evento.preventDefault()
    alert('Registro más adelante (aún no conectamos Supabase)')
  }
  document.getElementById('form-registro')?.addEventListener('submit', alEnviarRegistro)

  if (new URLSearchParams(window.location.search).get('panel') === 'registro') {
    document.getElementById('registro')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    document.getElementById('nombre')?.focus()
  }
</script>
