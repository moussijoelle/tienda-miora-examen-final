                    id="telefono"
                    name="telefono"
                    type="tel"
                    autocomplete="tel"
                    class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-800"
                  />
                </div>
                <div>
                  <label for="password" class="block text-sm text-neutral-600">Contraseña</label>
                  <div class="relative mt-1">
                    <input
                      id="password"
                      name="password"
                      type="password"
                      required
                      minlength="8"
                      autocomplete="new-password"
                      aria-describedby="requisitos-password"
                      class="w-full border border-neutral-300 bg-white py-2 pl-3 pr-10 text-sm outline-none focus:border-neutral-800"
                    />
                    <button
                      type="button"
                      class="absolute inset-y-0 right-0 flex items-center px-3 text-neutral-500 hover:text-neutral-800"
                      data-toggle-password="password"
                      aria-label="Mostrar contraseña"
                    >
                      <svg class="icon-ojo-abierto h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12s-3.75 6.75-9.75 6.75S2.25 12 2.25 12z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
                      </svg>
                      <svg class="icon-ojo-cerrado hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228L3 3m13.5 13.5L21 21m-4.272-4.272L12 12" />
                      </svg>
                    </button>
                  </div>
                  <ul
                    id="requisitos-password"
                    class="mt-2 space-y-1 text-xs"
                    aria-live="polite"
                  >
                    <li data-req="longitud" class="flex items-center gap-1.5 text-neutral-400">
                      <span class="req-icon" aria-hidden="true">○</span>
                      <span>Mínimo 8 caracteres</span>
                    </li>
                    <li data-req="mayuscula" class="flex items-center gap-1.5 text-neutral-400">
                      <span class="req-icon" aria-hidden="true">○</span>
                      <span>Al menos una mayúscula</span>
                    </li>
                    <li data-req="minuscula" class="flex items-center gap-1.5 text-neutral-400">
                      <span class="req-icon" aria-hidden="true">○</span>
                      <span>Al menos una minúscula</span>
                    </li>
                    <li data-req="numero" class="flex items-center gap-1.5 text-neutral-400">
                      <span class="req-icon" aria-hidden="true">○</span>
                      <span>Al menos un número</span>
                    </li>
                    <li data-req="iguales" class="flex items-center gap-1.5 text-neutral-400">
                      <span class="req-icon" aria-hidden="true">○</span>
                      <span>Las dos contraseñas coinciden</span>
                    </li>
                  </ul>
                </div>
                <div>
                  <label for="password2" class="block text-sm text-neutral-600">Repetir contraseña</label>
                  <div class="relative mt-1">
                    <input
                      id="password2"
                      name="password2"
                      type="password"
                      required
                      minlength="8"
                      autocomplete="new-password"
                      class="w-full border border-neutral-300 bg-white py-2 pl-3 pr-10 text-sm outline-none focus:border-neutral-800"
                    />
                    <button
                      type="button"
                      class="absolute inset-y-0 right-0 flex items-center px-3 text-neutral-500 hover:text-neutral-800"
                      data-toggle-password="password2"
                      aria-label="Mostrar contraseña"
                    >
                      <svg class="icon-ojo-abierto h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12s-3.75 6.75-9.75 6.75S2.25 12 2.25 12z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
                      </svg>
                      <svg class="icon-ojo-cerrado hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228L3 3m13.5 13.5L21 21m-4.272-4.272L12 12" />
                      </svg>
                    </button>
                  </div>
                </div>
                <button
                  type="submit"
                  id="btn-registro"
                  class="mt-2 w-full bg-neutral-800 px-8 py-3 text-sm text-white hover:bg-neutral-700 disabled:opacity-60"
                >
                  Crear cuenta
                </button>
              </form>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Tienda>

<script>
  import { supabase } from '../lib/supabase'

  function guardarCookiesSesion(accessToken: string, refreshToken: string) {
    const maxAge = 60 * 60 * 24 * 7
    document.cookie = `sb-access-token=${accessToken}; path=/; max-age=${maxAge}; SameSite=Lax`
    document.cookie = `sb-refresh-token=${refreshToken}; path=/; max-age=${maxAge}; SameSite=Lax`
  }

  function destinoGuardado() {
    const params = new URLSearchParams(window.location.search)
    const next = params.get('next')
    const pagar = params.get('pagar') === '1'
    if (next && next.startsWith('/') && !next.startsWith('//')) {
      return pagar ? `${next}${next.includes('?') ? '&' : '?'}pagar=1` : next
    }
    const guardado = sessionStorage.getItem('miora-post-login')
    if (guardado && guardado.startsWith('/') && !guardado.startsWith('//')) {
      return guardado
    }
    return '/'
  }

  const loginBtn = document.getElementById('login-btn')
  loginBtn?.addEventListener('click', async () => {
    const destino = destinoGuardado()
    if (destino !== '/') {
      sessionStorage.setItem('miora-post-login', destino)
    }
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login`,
      },
    })
  })

  // Guía: al volver de Google a /login?code=... canjear y guardar cookies
  const codigoAuth = new URLSearchParams(window.location.search).get('code')
  if (codigoAuth) {
    const { data, error } = await supabase.auth.exchangeCodeForSession(codigoAuth)
    if (!error && data.session) {
      guardarCookiesSesion(data.session.access_token, data.session.refresh_token)
      const destino = destinoGuardado()
      sessionStorage.removeItem('miora-post-login')
      window.location.replace(destino)
    }
  }

  supabase.auth.onAuthStateChange(async (event, session) => {
    if (session) {
      guardarCookiesSesion(session.access_token, session.refresh_token)
    } else if (event === 'SIGNED_OUT') {
      document.cookie = 'sb-access-token=; path=/; max-age=0'
      document.cookie = 'sb-refresh-token=; path=/; max-age=0'
    }
  })

  function mostrarError(id: string, texto: string) {
    const caja = document.getElementById(id)
    if (!caja) return
    caja.textContent = texto
    caja.classList.remove('hidden')
  }

  function ocultarAviso(id: string) {
    const caja = document.getElementById(id)
    if (!caja) return
    caja.textContent = ''
    caja.classList.add('hidden')
  }

  function mensajeRegistro(error: { message?: string; code?: string } | null) {
    const texto = (error?.message || '').toLowerCase()
    const codigo = (error?.code || '').toLowerCase()
    if (
      codigo.includes('user_already_exists') ||
      texto.includes('already registered') ||
      texto.includes('already been registered') ||
      texto.includes('user already exists')
    ) {
      return 'Este email ya tiene una cuenta. Inicia sesión o usa otro email.'
    }
    if (texto.includes('password')) {
      return 'La contraseña no cumple los requisitos de seguridad.'
    }
    return error?.message || 'No se pudo crear la cuenta. Inténtalo de nuevo.'
  }

  function validarContrasenaTienda(password: string): string | null {
    if (password.length < 8) {
      return 'La contraseña debe tener al menos 8 caracteres.'
    }
    if (!/[A-ZÁÉÍÓÚÑ]/.test(password)) {
      return 'La contraseña debe incluir al menos una letra mayúscula.'
    }
    if (!/[a-záéíóúñ]/.test(password)) {
      return 'La contraseña debe incluir al menos una letra minúscula.'
    }
    if (!/[0-9]/.test(password)) {
      return 'La contraseña debe incluir al menos un número.'
    }
    return null
  }

  function marcarRequisito(clave: string, ok: boolean, activo: boolean) {
    const item = document.querySelector<HTMLElement>(`[data-req="${clave}"]`)
    if (!item) return
    const icono = item.querySelector('.req-icon')
    item.classList.remove('text-neutral-400', 'text-red-600', 'text-green-600')
    if (!activo) {
      item.classList.add('text-neutral-400')
      if (icono) icono.textContent = '○'
      return
    }
    if (ok) {
      item.classList.add('text-green-600')
      if (icono) icono.textContent = '✓'
    } else {
      item.classList.add('text-red-600')
      if (icono) icono.textContent = '✕'
    }
  }

  function actualizarChecklistPassword() {
    const password =
      (document.getElementById('password') as HTMLInputElement | null)?.value ?? ''
    const password2 =
      (document.getElementById('password2') as HTMLInputElement | null)?.value ?? ''
    const activo = password.length > 0 || password2.length > 0

    marcarRequisito('longitud', password.length >= 8, activo)
    marcarRequisito('mayuscula', /[A-ZÁÉÍÓÚÑ]/.test(password), activo)
    marcarRequisito('minuscula', /[a-záéíóúñ]/.test(password), activo)
    marcarRequisito('numero', /[0-9]/.test(password), activo)
    marcarRequisito(
      'iguales',
      password.length > 0 && password2.length > 0 && password === password2,
      activo,
    )
  }

  document.getElementById('password')?.addEventListener('input', actualizarChecklistPassword)
  document.getElementById('password2')?.addEventListener('input', actualizarChecklistPassword)

  async function guardarClienteTrasAlta(datos: {
    nombres: string
    apellido1: string
    telefono: string
  }) {
    const cuerpo = new FormData()
    cuerpo.append('nombres', datos.nombres)
    cuerpo.append('apellido1', datos.apellido1)
    cuerpo.append('nombre', `${datos.nombres} ${datos.apellido1}`.trim())
    cuerpo.append('telefono', datos.telefono)
    cuerpo.append('enviar-brevo', 'true')

    await fetch('/api/clientes/crear', {
      method: 'POST',
      body: cuerpo,
      credentials: 'same-origin',
      redirect: 'manual',
    })
  }

  document.getElementById('form-login-email')?.addEventListener('submit', async (evento) => {
    evento.preventDefault()
    ocultarAviso('error-login')

    const form = evento.currentTarget as HTMLFormElement
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    const password = (form.elements.namedItem('password') as HTMLInputElement).value

    const { data, error } = await supabase.auth.signInWithPassword({ email, password })
    if (error || !data.session) {
      mostrarError('error-login', 'Email o contraseña incorrectos.')
      return
    }

    guardarCookiesSesion(data.session.access_token, data.session.refresh_token)
    const destino = destinoGuardado()
    sessionStorage.removeItem('miora-post-login')
    window.location.replace(destino === '/' ? '/perfil' : destino)
  })

  document.getElementById('form-registro')?.addEventListener('submit', async (evento) => {
    evento.preventDefault()
    ocultarAviso('error-registro')
    ocultarAviso('ok-registro')

    const form = evento.currentTarget as HTMLFormElement
    const btn = document.getElementById('btn-registro') as HTMLButtonElement | null
    const nombres = (form.elements.namedItem('nombre') as HTMLInputElement).value.trim()
    const apellido1 = (form.elements.namedItem('apellido1') as HTMLInputElement).value.trim()
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    const telefono = (form.elements.namedItem('telefono') as HTMLInputElement).value.trim()
    const password = (form.elements.namedItem('password') as HTMLInputElement).value
    const password2 = (form.elements.namedItem('password2') as HTMLInputElement).value

    if (password !== password2) {
      mostrarError('error-registro', 'Las contraseñas no coinciden.')
      return
    }
    const falloPassword = validarContrasenaTienda(password)
    if (falloPassword) {
      mostrarError('error-registro', falloPassword)
      return
    }

    if (btn) btn.disabled = true

    const nombreCompleto = `${nombres} ${apellido1}`.trim()
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: {
          full_name: nombreCompleto,
          nombre: nombres,
          apellido1,
        },
      },
    })

    if (error) {
      mostrarError('error-registro', mensajeRegistro(error))
      if (btn) btn.disabled = false
      return
    }

    if (data.session) {
      guardarCookiesSesion(data.session.access_token, data.session.refresh_token)
      try {
        await guardarClienteTrasAlta({ nombres, apellido1, telefono })
      } catch (err) {
        console.error('Error guardando cliente tras registro:', err)
      }
      window.location.replace('/perfil')
      return
    }

    const ok = document.getElementById('ok-registro')
    if (ok) {
      ok.textContent =
        'Cuenta creada. Si Supabase pide confirmar el email, revisa tu correo y luego inicia sesión aquí.'
      ok.classList.remove('hidden')
    }
    if (btn) btn.disabled = false
  })

  document.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-toggle-password')
      const input = id ? document.getElementById(id) : null
      if (!(input instanceof HTMLInputElement)) return

      const visible = input.type === 'text'
      input.type = visible ? 'password' : 'text'
      btn.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña')
      btn.querySelector('.icon-ojo-abierto')?.classList.toggle('hidden', !visible)
      btn.querySelector('.icon-ojo-cerrado')?.classList.toggle('hidden', visible)
    })
  })

  if (new URLSearchParams(window.location.search).get('panel') === 'registro') {
    document.getElementById('registro')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    document.getElementById('nombre')?.focus()
  }
</script>
