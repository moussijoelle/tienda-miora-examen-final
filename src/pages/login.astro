---
import Tienda from '../layouts/Tienda.astro'
import { supabase } from '../lib/supabase'

function rutaSegura(ruta: string | null) {
  if (!ruta || !ruta.startsWith('/') || ruta.startsWith('//')) {
    return null
  }
  return ruta
}

const nextParam = rutaSegura(Astro.url.searchParams.get('next'))
const quierePagar = Astro.url.searchParams.get('pagar') === '1'
const destinoTrasLogin =
  nextParam && quierePagar
    ? `${nextParam}${nextParam.includes('?') ? '&' : '?'}pagar=1`
    : nextParam

const accessToken = Astro.cookies.get('sb-access-token')
const refreshToken = Astro.cookies.get('sb-refresh-token')
let user = null
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  })

  if (data.user) {
    user = data.user
  }
  console.log('ID del usuario activo en servidor:', user?.id)
}

if (user && destinoTrasLogin) {
  return Astro.redirect(destinoTrasLogin)
}
---

<Tienda titulo="Iniciar sesión — Miora">
  <section class="flex min-h-[70vh] items-center justify-center px-4 py-12">
    <div
      class="relative w-full max-w-3xl border border-neutral-300 bg-white shadow-sm"
      role="dialog"
      aria-labelledby="titulo-login"
    >
      <a
        href="/"
        class="absolute right-3 top-3 z-10 flex h-8 w-8 items-center justify-center text-xl leading-none text-neutral-700 hover:bg-neutral-100"
        aria-label="Cerrar"
      >
        ×
      </a>

      {
        user ? (
          <div class="px-8 py-12 text-center sm:px-12">
            <h1 id="titulo-login" class="text-2xl font-light text-miora">
              Bienvenida
            </h1>
            <p class="mt-6 text-sm text-neutral-700">
              Sesión iniciada con: <strong>{user.email}</strong>
            </p>
            <p class="mt-2 text-sm text-neutral-600">
              Tu ID de Supabase es: <code class="text-xs">{user.id}</code>
            </p>
            <form action="/api/auth/signout" method="POST" class="mt-8">
              <button
                type="submit"
                class="bg-neutral-800 px-8 py-3 text-sm text-white hover:bg-neutral-700"
              >
                Cerrar Sesión
              </button>
            </form>
          </div>
