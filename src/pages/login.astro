          <div class="grid md:grid-cols-2">
            <div class="flex flex-col px-8 py-10 sm:px-10">
              <p class="text-center text-xs tracking-wide text-neutral-400">Acceso</p>
              <h1 id="titulo-login" class="mt-4 text-center text-2xl font-light text-miora">
                Iniciar sesión
              </h1>
              <p class="mt-2 text-center text-sm text-neutral-500">
                Google o email y contraseña
              </p>

              <button
                type="button"
                id="login-btn"
                class="mt-8 flex w-full items-center justify-center gap-3 border border-neutral-300 px-4 py-3 text-sm hover:bg-neutral-50"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
                Iniciar Sesión con Google
              </button>

              <div class="my-6 flex items-center gap-3 text-xs text-neutral-400">
                <span class="h-px flex-1 bg-neutral-200"></span>
                o
                <span class="h-px flex-1 bg-neutral-200"></span>
              </div>

              <form id="form-login-email" class="space-y-3 text-left">
                <p
                  id="error-login"
                  class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
                  role="alert"
