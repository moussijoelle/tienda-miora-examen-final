  <section class="flex h-full flex-col justify-center px-8 py-10 sm:px-12 [text-shadow:0_1px_12px_rgb(0_0_0_/_40%)]">
    <p class="font-serif text-3xl tracking-[0.18em] sm:text-5xl">
      Compra ahora
    </p>
    <h1 class="mt-4 max-w-xl font-serif text-2xl font-light italic leading-snug text-white/90 sm:text-3xl">
      Para que te veas como te sientes.
    </h1>
  </section>
</Tienda>
